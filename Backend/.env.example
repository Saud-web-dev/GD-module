PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/your_database
FRONTEND_URL=http://localhost:5173

# OAuth 2.0 Credentials (for personal Google Drive)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Token storage path (where OAuth tokens will be saved)
GOOGLE_TOKENS_PATH=./google-tokens.json

# Optional: Default folder ID for uploads (can be overridden per request)
GOOGLE_DRIVE_FOLDER_ID=optional-folder-id

# Automatic Backup Configuration
ENABLE_AUTO_BACKUP=false
BACKUP_INTERVAL_MINUTES=60
